<h3>Image gallery</h3>
@{
    List<string> l = new List<string>();
    l=(List<string>)ViewBag.sources;
    for (var i = 0; i < l.Count; i++)
    {
        var s = l[i];
        <img src="@Url.Content(s)" width="200" height="100" />
    }
}
